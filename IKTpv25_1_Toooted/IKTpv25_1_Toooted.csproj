<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- "annotations": string? = valikuline veerg EF Core'is, ilma hoiatuste tulvata vanas koodis -->
    <Nullable>annotations</Nullable>
    <RootNamespace>IKTpv25_1_Toooted</RootNamespace>
    <AssemblyName>IKTpv25_1_Toooted</AssemblyName>
    <Company>TTHK</Company>
    <Product>Tooded App</Product>
    <ApplicationIcon>Ikoon.ico</ApplicationIcon>
    <!-- Kood loob vormid pikslites: Windows skaleerib (125-150 %) kogu akna ühtlaselt, tekst jääb terav -->
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.6" />
    <!-- SQLite: andmebaas on üks fail, eraldi serverit pole vaja (installeri jaoks) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- PDF-arve -->
    <PackageReference Include="PdfSharpCore" Version="1.3.63" />
    <!-- paroolide räsi -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- pangaülekande QR-kood (EPC / SEPA) -->
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <!-- e-posti rakenduse parool salvestatakse krüpteeritult (Windows DPAPI) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Algtoodete pildid kopeeritakse väljundkausta; Program kopeerib need edasi AppData kausta -->
  <ItemGroup>
    <None Update="Pildid\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Rimi e-poe kataloog (laaditakse andmebaasi esimesel käivitamisel) -->
    <None Update="Andmed\rimi_kataloog.json.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
